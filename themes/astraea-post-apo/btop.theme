# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#12100F"

# Main text color
theme[main_fg]="#F3E6C8"

# Title color for boxes
theme[title]="#F3E6C8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7A8FC4"

# Background color of selected item in processes box
theme[selected_bg]="#3A2E22"

# Foreground color of selected item in processes box
theme[selected_fg]="#7A8FC4"

# Color of inactive/disabled text
theme[inactive_fg]="#7A746C"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#F8EFD8"

# Background color of the percentage meters
theme[meter_bg]="#3A2E22"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#F8EFD8"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#C8789A"
theme[mem_box]="#8DB36A"
theme[net_box]="#E0604E"
theme[proc_box]="#7A8FC4"

# Box divider line and small boxes line color
theme[div_line]="#7A746C"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8DB36A"
theme[temp_mid]="#E4BE81"
theme[temp_end]="#E0604E"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#6FC3D0"
theme[cpu_mid]="#7A8FC4"
theme[cpu_end]="#C8789A"

# Mem/Disk free meter
theme[free_start]="#C8789A"
theme[free_mid]="#7A8FC4"
theme[free_end]="#6FC3D0"

# Mem/Disk cached meter
theme[cached_start]="#7A8FC4"
theme[cached_mid]="#6FC3D0"
theme[cached_end]="#C8789A"

# Mem/Disk available meter
theme[available_start]="#E4BE81"
theme[available_mid]="#E0604E"
theme[available_end]="#E0604E"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8DB36A"
theme[used_mid]="#6FC3D0"
theme[used_end]="#7A8FC4"

# Download graph colors
theme[download_start]="#E4BE81"
theme[download_mid]="#E0604E"
theme[download_end]="#E0604E"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8DB36A"
theme[upload_mid]="#6FC3D0"
theme[upload_end]="#7A8FC4"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6FC3D0"
theme[process_mid]="#7A8FC4"
theme[process_end]="#C8789A"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#12100F"
theme[gradient_color_1]="#241E1A"
theme[gradient_color_2]="#3A2E22"
theme[gradient_color_3]="#7A746C"
theme[gradient_color_4]="#A09478"
theme[gradient_color_5]="#F3E6C8"
theme[gradient_color_6]="#F8EFD8"
theme[gradient_color_7]="#FFF6E2"
